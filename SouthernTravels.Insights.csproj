    <Compile Remove="Core/**;Areas/**;Common/AccountApiEndpoints.cs;Models/TicketServiceStatusModels.cs" />
    <Content Remove="Core/**;Areas/**;Views/Operations/**" />
    <None Remove="Core/**;Areas/**;Views/Operations/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
