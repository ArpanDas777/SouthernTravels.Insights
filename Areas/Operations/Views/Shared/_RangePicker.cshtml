@model SouthernTravels.Core.Infrastructure.RangePicker
@* One control for a From – To range: a button that opens a calendar on focus (CSS only; the calendar is a sample). *@
<div class="rp">
    <button type="button" class="rp-btn" aria-haspopup="dialog">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
        <span>@Model.Button</span>
    </button>
    <div class="rp-pop" tabindex="-1" role="dialog" aria-label="Select date range">
        <div class="rp-head"><span class="rp-nav">‹</span><b>@Model.Month</b><span class="rp-nav">›</span></div>
        <div class="rp-dow"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
        <div class="rp-days">
            @for (var i = 0; i < Model.LeadBlanks; i++) {<span class="rp-d blank"></span>}
            @foreach (var d in Model.Days) {<span class="rp-d @d.Cls">@d.Text</span>}
        </div>
        <div class="rp-foot">@Model.Footer</div>
    </div>
</div>
