@model ReportPage
@* KPI cards → view tabs → toolbar → collapsible filter panel. Elements marked data-frag are refreshed in place by site.js. *@
@{
    var q = Model.Query;
}
<div class="frag" data-frag="kpis">
    @if (Model.Kpis.Count > 0)
    {
        @* Cancellation Report: 10 KPIs as 2 rows of 5. *@
        <div class="kpis @(Model.Id == "r5" ? "five" : "")">
            @foreach (var k in Model.Kpis)
            {
                <div class="kpi" title="@(k.Tip ?? "")">
                    <div class="k-l">@k.Label</div>
                    <div class="k-v @(k.Big ? "big" : "")" style="color:@k.Color">@k.Value</div>
                    @if (k.Sub is not null)
                    {
                        <div class="k-s">@k.Sub</div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (Model.Tabs.Count > 0)
{
    <div class="frag" data-frag="tabs">
        <div class="tabs">
            @foreach (var t in Model.Tabs)
            {
                <button type="button" class="tab @(t.Key == Model.ActiveTab ? "active" : "")" data-tab="@t.Key">@t.Label</button>
            }
        </div>
    </div>
}

@if (Model.HasToolbar)
{
    <div class="toolbar @(Model.Tabs.Count > 0 ? "has-tabs" : "")">
        <label class="search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input data-action="search" value="@q.Search" placeholder="@Model.SearchPlaceholder" />
        </label>
        <button type="button" class="tb-btn" data-action="toggle-filters">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"></path><circle cx="16" cy="6" r="2"></circle><circle cx="10" cy="12" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg>Filters
            <span class="fc" data-frag="fbadge">@if (q.ActiveFilterCount > 0) {<span class="badge">@q.ActiveFilterCount</span>}</span>
        </button>
        <span class="fc" data-frag="clearall">
            @if (q.AnyActive)
            {
                <button type="button" class="tb-btn danger" data-action="clear-all">Clear all</button>
            }
        </span>
        <span class="count" data-frag="label">@Model.ResultLabel</span>
        <span class="spacer"></span>
        <button type="button" class="tb-btn primary" data-action="export">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 20h16"></path></svg>Export
        </button>
        <button type="button" class="tb-btn" data-action="expand-all">Expand All</button>
        <button type="button" class="tb-btn" data-action="collapse-all">Collapse All</button>
    </div>

    <div class="filters" id="filter-panel" hidden>
        <div class="filters-head">
            <button type="button" class="btn-clear" data-action="clear-all">Clear filters</button>
        </div>
        <div class="grid">
            @foreach (var f in Model.Filters)
            {
                var sel = q.F(f.Label);
                <label class="flt">
                    @f.Label
                    <select data-filter="f_@f.Slug">
                        <option value="">All</option>
                        @foreach (var o in f.Options)
                        {
                            <option value="@o" selected="@(sel == o)">@o</option>
                        }
                    </select>
                </label>
            }
            @foreach (var d in Model.DateFields)
            {
                var (from, to) = q.Range(d);
                var text = from is null ? "Select date range" : Fmt.Date(from.Value) + " – " + (to is null ? "select end date" : Fmt.Date(to.Value));
                <div class="flt">
                    @d
                    <button type="button" class="range-btn @(from is null ? "" : "set")" data-range="@ReportQuery.Slug(d)"
                            data-from="@(from is null ? "" : Fmt.Iso(from.Value))" data-to="@(to is null ? "" : Fmt.Iso(to.Value))">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                        <span>@text</span>
                    </button>
                </div>
            }
        </div>
    </div>
}
