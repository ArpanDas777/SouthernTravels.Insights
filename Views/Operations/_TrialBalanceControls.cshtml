@model ServiceWisePage
@* Trial Balance toolbar controls after the search box: Period preset, Financial year, range chip, Service type, Vendor, Print. Visual only: the ledger below is the fixed sample vendor. *@
@{
    var tb = Model.Tb!;
}
<label class="tb-field">Period
    <select class="tb-sel" aria-label="Period">
        @foreach (var o in TrialBalance.Presets)
        {
            <option value="@o" selected="@(o == tb.Preset)">@o</option>
        }
    </select>
</label>
<select class="tb-sel" aria-label="Financial year">
    @foreach (var o in TrialBalance.FyLabels)
    {
        <option value="@o" selected="@(o == tb.Fy)">@o</option>
    }
</select>
<span class="tb-range">@tb.RangeText</span>
<span class="tb-vrule"></span>
<select class="tb-sel" aria-label="Service type">
    @foreach (var o in TrialBalance.TypeFilters)
    {
        <option value="@o" selected="@(o == tb.TypeFilter)">@o</option>
    }
</select>
<div class="vsel">
    <input class="vsel-input" type="text" placeholder="Search vendor…" aria-label="Vendor" value="@tb.VendorText" readonly />
    @* Opens on focus (CSS only); each vendor is a link that reloads the ledger for it. *@
    <div class="vsel-list" role="listbox">
        @foreach (var o in TrialBalance.Vendors)
        {
            <a class="vsel-opt @(o.Id == tb.VendorId ? "on" : "")" role="option" href="?tab=tb&vendor=@o.Id"><span>@o.Name</span><small>@o.Id · @o.Type</small></a>
        }
    </div>
</div>
<button type="button" class="tb-btn" title="Print" aria-label="Print">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v7H6z"></path></svg><span class="tb-lbl">Print</span>
</button>
