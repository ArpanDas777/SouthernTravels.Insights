@model ServiceWisePage
@* Trial Balance toolbar controls after the search box: Vendor, Financial year, From month, to, To month, Print. Visual only: the ledger below is the fixed sample vendor. *@
@{
    var tb = Model.Tb!;
}
<div class="vsel">
    <input class="vsel-input" type="text" placeholder="Search vendor…" aria-label="Vendor" value="@tb.VendorText" readonly />
</div>
<select class="tb-sel" aria-label="Financial year">
    @foreach (var o in TrialBalance.FyLabels)
    {
        <option value="@o" selected="@(o == tb.Fy)">@o</option>
    }
</select>
<select class="tb-sel" aria-label="From month">
    @foreach (var o in TrialBalance.Months)
    {
        <option value="@o" selected="@(o == tb.FromMonth)">@o</option>
    }
</select>
<span class="tb-to">to</span>
<select class="tb-sel" aria-label="To month">
    @foreach (var o in TrialBalance.Months)
    {
        <option value="@o" selected="@(o == tb.ToMonth)">@o</option>
    }
</select>
<button type="button" class="tb-btn" title="Print" aria-label="Print">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v7H6z"></path></svg><span class="tb-lbl">Print</span>
</button>
